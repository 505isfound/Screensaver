// Everything packed inside IrisNebula.scr
#include <windows.h>
#include "src/resource.h"

1 24 "src/app.manifest"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Iris Nebula"
END

IDR_PICTURE     RCDATA "assets/iris.jpg"
IDR_BACKGROUND  RCDATA "assets/background.png"
IDR_STARS       RCDATA "assets/stars.bin"
IDR_SHADERS     RCDATA "src/shaders.hlsl"

IDD_SETTINGS DIALOGEX 0, 0, 260, 176
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Iris Nebula Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Monitors:", -1, 10, 12, 70, 10
    COMBOBOX        IDC_LAYOUT, 85, 10, 165, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Star twinkle:", -1, 10, 32, 70, 10
    COMBOBOX        IDC_TWINKLE, 85, 30, 165, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Nebula glow:", -1, 10, 52, 70, 10
    COMBOBOX        IDC_NEBULA, 85, 50, 165, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX    "Slowly zoom in and out", IDC_ZOOM, 85, 70, 165, 12, WS_TABSTOP
    LTEXT           "Picture: Iris Nebula (NGC 7023).\nCredit: NASA, ESA and Digitized Sky Survey 2.\nAcknowledgment: Davide De Martin (ESA/Hubble).", IDC_CREDIT, 10, 96, 240, 36
    DEFPUSHBUTTON   "OK", IDOK, 146, 150, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 150, 50, 16
END
